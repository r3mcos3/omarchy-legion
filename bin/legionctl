#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

program=${0##*/}

die() {
  local code=$1
  shift
  printf '%s: %s\n' "$program" "$*" >&2
  exit "$code"
}

usage_error() {
  die 2 'usage: legionctl roster --json | cron-jobs --json | usage --json |
  notifications --json [--limit N] | notifications check | notifications mark-seen |
  tasks list --json | tasks add MEMBER TITLE | tasks send ID [MESSAGE] | tasks done ID |
  members add NAME CWD |
  session start|stop|restart NAME |
  start-all'
}

# This is a personal-use companion to the claude-legion dashboard webapp
# (which keeps running independently) — NOT a hardened, publicly-distributed
# tool like bin/aliasctl in the zsh-alias-manager repo. It deliberately shares
# members.json/tasks.json/log-history.json/cron-jobs.json with the webapp
# (both read AND write them) rather than inventing a second source of truth,
# so either UI reflects the other's changes. That means a read-modify-write
# from here can theoretically race a concurrent write from the webapp's own
# Node process; for how rarely either side actually writes (a manual click),
# that residual risk is accepted rather than engineered around.

legion_root=$HOME/claude-legion
dashboard_dir=$legion_root/dashboard
members_path=$dashboard_dir/members.json
tasks_path=$dashboard_dir/tasks.json
log_path=$dashboard_dir/log-history.json
cron_jobs_path=$legion_root/cron-jobs.json
usage_cache_path=$HOME/.claude/usage-cache.json

fixed_names=(hours favs fantasy fpl home)
declare -A workspaces=(
  [hours]="$HOME/Documents/github/hours"
  [favs]="$HOME/Documents/github/favs"
  [fantasy]="$HOME/Documents/github/fantasy-league-26-27"
  [fpl]="$HOME/Documents/github/fpl-tracker-26-27"
  [home]="$HOME/homeassistant"
  [boss]="$legion_root"
)

name_re='^[a-z][a-z0-9-]{0,23}$'

# --- shared helpers ----------------------------------------------------------

read_json_or() {
  local path=$1 fallback=$2
  if [[ -f $path ]]; then
    local content
    content=$(cat -- "$path")
    if jq -e . >/dev/null 2>&1 <<<"$content"; then
      printf '%s' "$content"
      return 0
    fi
  fi
  printf '%s' "$fallback"
}

# Node's own boot skips to the first '[' to tolerate a version-manager
# banner line ahead of the JSON (see server.js's runClaudeAgentsJSON) —
# same tolerance here.
run_agents_json() {
  local raw sliced
  raw=$(claude agents --json 2>/dev/null || true)
  sliced=$(printf '%s\n' "$raw" | sed -n '/^\[/,$p')
  if [[ -n $sliced ]] && jq -e . >/dev/null 2>&1 <<<"$sliced"; then
    printf '%s' "$sliced"
  else
    printf '[]'
  fi
}

dynamic_members_json() {
  read_json_or "$members_path" '[]'
}

known_names_json() {
  local fixed_json members_json
  fixed_json=$(printf '%s\n' "${fixed_names[@]}" boss | jq -R . | jq -s .)
  members_json=$(dynamic_members_json | jq '[.[].name]')
  jq -n --argjson a "$fixed_json" --argjson b "$members_json" '$a + $b'
}

is_known_name() {
  local name=$1
  known_names_json | jq -e --arg n "$name" 'index($n) != null' >/dev/null
}

workspace_for() {
  local name=$1
  if [[ -n ${workspaces[$name]+x} ]]; then
    printf '%s' "${workspaces[$name]}"
    return 0
  fi
  dynamic_members_json | jq -r --arg n "$name" '.[] | select(.name == $n) | .cwd' | head -1
}

# --- roster ------------------------------------------------------------------

cmd_roster() {
  local agents_json members_json fixed_json workspaces_json
  agents_json=$(run_agents_json)
  members_json=$(dynamic_members_json)
  fixed_json=$(printf '%s\n' "${fixed_names[@]}" | jq -R . | jq -s .)
  workspaces_json=$(jq -n \
    --arg hours "${workspaces[hours]}" --arg favs "${workspaces[favs]}" \
    --arg fantasy "${workspaces[fantasy]}" --arg fpl "${workspaces[fpl]}" \
    --arg home "${workspaces[home]}" --arg boss "${workspaces[boss]}" \
    '{hours:$hours, favs:$favs, fantasy:$fantasy, fpl:$fpl, home:$home, boss:$boss}')

  jq -n \
    --argjson agents "$agents_json" \
    --argjson members "$members_json" \
    --argjson fixed "$fixed_json" \
    --argjson workspaces "$workspaces_json" \
    '
    (["boss"] + $fixed + ($members | map(.name))) as $order
    | ($agents | map({key: .name, value: .}) | from_entries) as $byName
    | ($members | map({key: .name, value: .cwd}) | from_entries) as $memberCwd
    | [ $order[] as $name
        | ($byName[$name]) as $a
        | {
            name: $name,
            isFixed: ($fixed | index($name) != null),
            isBoss: ($name == "boss"),
            online: ($a != null),
            id: ($a.id // null),
            cwd: ($a.cwd // $workspaces[$name] // $memberCwd[$name] // null),
            status: ($a.status // null),
            state: ($a.state // null)
          }
      ]
    '
}

# --- cron jobs -----------------------------------------------------------

cmd_cron_jobs() {
  read_json_or "$cron_jobs_path" '[]'
}

# --- usage -----------------------------------------------------------------

cmd_usage() {
  local data
  data=$(read_json_or "$usage_cache_path" 'null')
  if [[ $data == null ]]; then
    printf '%s' 'null'
    return 0
  fi
  if jq -e '(.fiveHour | type) == "number" and (.sevenDay | type) == "number"' >/dev/null 2>&1 <<<"$data"; then
    printf '%s' "$data"
  else
    printf '%s' 'null'
  fi
}

# --- notifications -----------------------------------------------------------

cmd_notifications() {
  local limit=40
  while (($#)); do
    case $1 in
      --limit)
        limit=$2
        shift 2
        ;;
      *) usage_error ;;
    esac
  done
  read_json_or "$log_path" '[]' | jq --argjson n "$limit" '.[-$n:]'
}

# --- message detection --------------------------------------------------------
#
# Two jobs share one transcript-scanning pass, across EVERY known session
# (boss + fixed + dynamic), not just boss:
#
# 1. Task-reply detection (standalone equivalent of the webapp's
#    advanceTasksOnReply): when a member reports back to boss via
#    SendMessage, that reply lands as a perfectly ordinary entry in BOSS's
#    OWN transcript — either a plain `type:"user"` text block wrapping a
#    <cross-session-message from-name="X">...</cross-session-message> tag,
#    or a structured `type:"attachment"` entry whose attachment.origin.kind
#    is "peer". Advances the matching in_progress task, same as before.
#
# 2. General "vraag of antwoord" notifications: ANY new message in ANY
#    session's own transcript — a prompt landing on that member (typed by
#    hand, or a cross-session message from boss), or that member's own
#    assistant text answer — fires a desktop notification + blinks that
#    member's row, unless its terminal window currently has focus. This is
#    deliberately broad (every text turn, not just tracked tasks) per an
#    explicit choice to favor completeness over quiet — a member that talks
#    a lot will notify a lot.
#
# Boss's own peer-origin entries are only routed through job 1 (they already
# get a nicer, task-specific notification via the transitions check below);
# every other message — including boss's own plain assistant replies, which
# is exactly what was missing before this — goes through job 2.
projects_dir=$HOME/.claude/projects

# Mirrors server.js's projectDirFor + findTranscriptPath: the project
# directory encodes cwd by replacing "/" with "-"; prefer the session's own
# transcript file, else fall back to the most recently modified .jsonl in
# that directory (a just-(re)started or --continue'd session may not have
# written its own file yet).
find_transcript_path() {
  local cwd=$1 session_id=$2
  local dir="$projects_dir/$(printf '%s' "$cwd" | tr '/' '-')"
  local direct="$dir/$session_id.jsonl"
  if [[ -f $direct ]]; then
    printf '%s' "$direct"
    return 0
  fi
  [[ -d $dir ]] || return 1
  find "$dir" -maxdepth 1 -name '*.jsonl' -printf '%T@ %p\n' 2>/dev/null \
    | sort -rn | head -1 | cut -d' ' -f2-
}

# Reads new complete lines since $2 (byte offset) and prints
# {newOffset, messages:[{kind, peer, from, text}], pending}. kind is "user"
# (a prompt landing on this session, by hand or via cross-session-message)
# or "assistant" (a *confirmed-final* text answer — see below); peer/from
# are set only for a recognized cross-session-message or peer-origin
# attachment.
#
# A turn's assistant text-block-only messages and its tool-call messages
# are never mixed in the same transcript entry here — a status update like
# "checking the file now" and the tool call it precedes are always two
# separate entries — so text presence alone can't tell an intermediate
# one-liner apart from the actual final answer. What can: whether another
# assistant entry (i.e. a tool call, since that's the only thing that
# follows a mid-turn update) comes after it before the turn hands back to
# a real user/peer entry. $3 carries the still-unconfirmed candidate text
# from the previous poll (or "") so this holds across polls; a still-
# unconfirmed candidate at the end of THIS batch is returned as `pending`
# for the next poll to keep tracking, not fired yet. A tool-result-only
# user entry doesn't confirm anything — the agentic loop just continues.
#
# A NUL-safe, binary-aware read (not `tail -c`/`dd` chained through bash)
# because JSONL transcript content is arbitrary text; only ever processes
# up to the last full newline so a line still being written is picked up
# whole on the next poll, never parsed half-written.
scan_transcript_messages() {
  python3 -I -c '
import json, re, sys

path, offset, pending = sys.argv[1], int(sys.argv[2]), (sys.argv[3] or None)
CROSS_SESSION_RE = re.compile(
    r"<cross-session-message[^>]*from-name=\"([^\"]+)\"[^>]*>(.*?)</cross-session-message>",
    re.DOTALL,
)

with open(path, "rb") as f:
    f.seek(offset)
    chunk = f.read()

last_nl = chunk.rfind(b"\n")
if last_nl == -1:
    print(json.dumps({"newOffset": offset, "messages": [], "pending": pending}))
    sys.exit(0)

usable = chunk[:last_nl]
new_offset = offset + last_nl + 1
messages = []

def text_blocks(content):
    if not isinstance(content, list):
        return []
    out = []
    for block in content:
        if isinstance(block, dict) and block.get("type") == "text":
            t = (block.get("text") or "").strip()
            if t:
                out.append(t)
    return out

def confirm_pending():
    global pending
    if pending:
        messages.append({"kind": "assistant", "peer": False, "from": None, "text": pending})
    pending = None

for raw_line in usable.split(b"\n"):
    raw_line = raw_line.strip()
    if not raw_line:
        continue
    try:
        entry = json.loads(raw_line)
    except Exception:
        continue

    etype = entry.get("type")
    if etype == "user":
        content = (entry.get("message") or {}).get("content")
        candidates = [content] if isinstance(content, str) else text_blocks(content)
        if not candidates:
            continue  # tool-result-only feedback — loop continues, not a turn boundary
        confirm_pending()
        for t in candidates:
            m = CROSS_SESSION_RE.search(t)
            if m:
                messages.append({"kind": "user", "peer": True, "from": m.group(1), "text": m.group(2).strip()})
            else:
                t = t.strip()
                if t:
                    messages.append({"kind": "user", "peer": False, "from": None, "text": t})
    elif etype == "attachment":
        origin = ((entry.get("attachment") or {}).get("origin")) or {}
        if origin.get("kind") == "peer":
            confirm_pending()
            messages.append({"kind": "user", "peer": True, "from": origin.get("name", ""), "text": (origin.get("body") or "").strip()})
    elif etype == "assistant":
        content = (entry.get("message") or {}).get("content")
        texts = text_blocks(content)
        if texts:
            pending = " ".join(texts)  # new unconfirmed candidate, supersedes any older one
        elif any(isinstance(b, dict) and b.get("type") == "tool_use" for b in (content or [])):
            pending = None  # a tool call followed — whatever was pending is proven non-final

print(json.dumps({"newOffset": new_offset, "messages": messages, "pending": pending}))
' "$1" "$2" "$3"
}

# Advances the oldest in_progress task for each replying member to
# approved_questions, filling .reply — same selection rule as
# advanceTasksOnReply (oldest by sentAt; a member works one task at a time).
apply_reply() {
  local from=$1 text=$2 tasks ts
  ts=$(date +%s%3N)
  tasks=$(load_tasks)
  tasks=$(jq --arg from "$from" --arg text "$text" --argjson ts "$ts" '
    (
      [.[] | select(.member == $from and .status == "in_progress")]
      | sort_by(.sentAt // 0)
      | .[0].id
    ) as $targetId
    | if $targetId == null then .
      else map(if .id == $targetId then
          .status = "approved_questions" | .reply = {text: $text, at: $ts}
        else . end)
      end
  ' <<<"$tasks")
  save_tasks "$tasks"
}

# True (exit 0) only when the currently FOCUSED window is that member's own
# terminal (opened with --title "legion:<name>", see Panel.qml's
# openTerminalFor). Uses initialTitle, not the live title — a running
# program (claude attach, the shell) can rewrite its own title afterward,
# but initialTitle is captured once at window-map time and stays put, so it
# can't be spoofed by whatever the child process does. Missing hyprctl or no
# match both mean "not focused" — the safe default is to notify.
is_terminal_focused() {
  local name=$1 active_title
  command -v hyprctl >/dev/null 2>&1 || return 1
  active_title=$(hyprctl activewindow -j 2>/dev/null | jq -r '.initialTitle // empty' 2>/dev/null) || return 1
  [[ $active_title == "legion:$name" ]]
}

notify_generic_message() {
  local name=$1 kind=$2 text=$3 headline
  text=${text//$'\n'/ }
  if ((${#text} > 200)); then
    text="${text:0:200}…"
  fi
  if [[ $kind == user ]]; then
    headline="$name — nieuwe vraag"
  else
    headline="$name — antwoord"
  fi
  omarchy-notification-send --app-name legion -u normal \
    "$headline" "$text" \
    --exec omarchy-shell r3mcos3.legion toggle \
    >/dev/null 2>&1 || true
  play_notification_sound
}

# Polls every known session's OWN transcript (not just boss's) for new
# messages, advances tasks on a boss-side peer reply (job 1 above), and
# fires a generic notification + blink for everything else (job 2), gated
# on that member's terminal not currently being focused.
#
# Job 2 fires for an incoming "vraag" (a kind:user message landing on that
# session) as soon as it arrives, and for a kind:assistant message only
# once scan_transcript_messages has CONFIRMED it was the turn's actual
# final answer, not one of the intermediate one-line status updates a busy
# turn can emit along the way (see that function's own comment for how).
# The still-unconfirmed candidate carries over between polls via
# .pendingAnswers[name] — passed back in as scan_transcript_messages's 3rd
# argument each time, and written back from its `pending` result below.
cmd_poll_all() {
  local marker roster names name

  marker=$(read_marker)
  roster=$(run_agents_json)
  names=$(jq -r '.[].name' <<<"$roster")

  while IFS= read -r name; do
    [[ -n $name ]] || continue

    local session_id cwd path prev prev_path prev_offset offset
    # .sessionId (the transcript-filename UUID), NOT .id (the short
    # background-job id claude agents/stop use) -- these are two different
    # identifiers server.js is also careful to keep apart.
    session_id=$(jq -r --arg n "$name" '.[] | select(.name == $n) | .sessionId' <<<"$roster")
    cwd=$(workspace_for "$name")
    [[ -n $session_id && $session_id != null && -n $cwd ]] || continue

    path=$(find_transcript_path "$cwd" "$session_id") || path=""
    [[ -n $path && -f $path ]] || continue

    prev=$(jq -c --arg n "$name" '.transcripts[$n] // {"path":"","offset":0}' <<<"$marker")
    prev_path=$(jq -r '.path' <<<"$prev")
    prev_offset=$(jq -r '.offset' <<<"$prev")

    if [[ $path != "$prev_path" ]]; then
      # New (or first-ever) transcript file for this session: seed at EOF,
      # same as the webapp's own pollTranscriptDelta — never backfill years
      # of history as "new" the first time this sees a session. Also drops
      # any pending candidate from the old file, which can never resolve now.
      offset=$(stat -c %s -- "$path")
      marker=$(jq --arg n "$name" --arg p "$path" --argjson o "$offset" \
        '.transcripts[$n] = {path:$p, offset:$o} | del(.pendingAnswers[$n])' <<<"$marker")
      continue
    fi

    local prev_pending scan new_offset new_pending msgs count i=0
    prev_pending=$(jq -r --arg n "$name" '.pendingAnswers[$n] // ""' <<<"$marker")
    scan=$(scan_transcript_messages "$path" "$prev_offset" "$prev_pending")
    new_offset=$(jq -r '.newOffset' <<<"$scan")
    new_pending=$(jq -r '.pending // ""' <<<"$scan")
    msgs=$(jq -c '.messages' <<<"$scan")
    count=$(jq 'length' <<<"$msgs")

    while (( i < count )); do
      local kind peer from text
      kind=$(jq -r --argjson i "$i" '.[$i].kind' <<<"$msgs")
      peer=$(jq -r --argjson i "$i" '.[$i].peer' <<<"$msgs")
      from=$(jq -r --argjson i "$i" '.[$i].from // ""' <<<"$msgs")
      text=$(jq -r --argjson i "$i" '.[$i].text' <<<"$msgs")

      if [[ $name == boss && $kind == user && $peer == true ]]; then
        # Job 1: already gets its own, nicer notification via the
        # transitions check in cmd_notifications_check — don't double it up.
        [[ -n $from ]] && apply_reply "$from" "$text"
      elif ! is_terminal_focused "$name"; then
        notify_generic_message "$name" "$kind" "$text"
        marker=$(jq --arg n "$name" '.unseen = ((.unseen // []) + [$n] | unique)' <<<"$marker")
      fi
      i=$((i + 1))
    done

    if [[ -n $new_pending ]]; then
      marker=$(jq --arg n "$name" --arg t "$new_pending" '.pendingAnswers[$n] = $t' <<<"$marker")
    else
      marker=$(jq --arg n "$name" 'del(.pendingAnswers[$n])' <<<"$marker")
    fi
    marker=$(jq --arg n "$name" --arg p "$path" --argjson o "$new_offset" \
      '.transcripts[$n] = {path:$p, offset:$o}' <<<"$marker")
  done <<<"$names"

  printf '%s' "$marker" > "$notify_marker_path"
}

# --- notify-check ------------------------------------------------------------
#
# advanceTasksOnReply's standalone equivalent (cmd_poll_all above, called
# first thing below) flips a task's status from in_progress to
# approved_questions the moment that member's reply lands in boss's own
# transcript, filling in .reply. Marking a task done by hand is the other
# terminal transition. cmd_poll_all also fires its own, broader
# notifications for every other message in every session (job 2) — this
# function layers a second, task-specific notification on top for the
# common "a task you sent just finished" case, since that deserves a nicer
# headline/body than the generic one.
notify_marker_path=$HOME/.config/omarchy/legion-notify-marker.json

read_marker() {
  read_json_or "$notify_marker_path" '{"lastSeenTs":0,"taskStatuses":{},"transcripts":{},"unseen":[],"pendingAnswers":{}}'
}

notification_sound_path=/usr/share/sounds/freedesktop/stereo/complete.oga

play_notification_sound() {
  [[ -f $notification_sound_path ]] || return 0
  command -v pw-play >/dev/null 2>&1 || return 0
  pw-play -- "$notification_sound_path" >/dev/null 2>&1 &
  disown
}

cmd_notifications_check() {
  local marker prev_statuses tasks transitions count

  # Job 1 + job 2 (see the comment block above cmd_poll_all): advances
  # tasks on a boss-side peer reply, and fires the broad generic
  # notification for every other message in every session. Writes its own
  # marker update (.transcripts / .unseen) before returning.
  cmd_poll_all

  marker=$(read_marker)
  prev_statuses=$(jq -c '.taskStatuses // {}' <<<"$marker")

  tasks=$(load_tasks)

  # One-shot: tasks that moved OUT of in_progress since the LAST check call
  # (auto-advanced to approved_questions by cmd_poll_all just above, or
  # marked done by hand from either UI) — fires exactly one, nicer desktop
  # notification per transition (on top of whatever job 2 already fired for
  # the same underlying message), gated the same way on that member's
  # terminal not being focused.
  transitions=$(jq --argjson prev "$prev_statuses" '
    [.[] | select(($prev[.id] // "") == "in_progress" and .status != "in_progress")]
  ' <<<"$tasks")

  count=$(jq 'length' <<<"$transitions")
  local newly_unseen='[]'
  local i=0
  while (( i < count )); do
    local member title status reply headline body
    member=$(jq -r --argjson i "$i" '.[$i].member' <<<"$transitions")
    title=$(jq -r --argjson i "$i" '.[$i].title' <<<"$transitions")
    status=$(jq -r --argjson i "$i" '.[$i].status' <<<"$transitions")
    reply=$(jq -r --argjson i "$i" '.[$i].reply.text // ""' <<<"$transitions")
    if ! is_terminal_focused "$member"; then
      headline="$member — opdracht klaar"
      body="\"$title\""
      [[ $status == done ]] && body="$body (afgerond)"
      [[ -n $reply ]] && body="$body: $reply"
      omarchy-notification-send --app-name legion -u normal \
        "$headline" "$body" \
        --exec omarchy-shell r3mcos3.legion toggle \
        >/dev/null 2>&1 || true
      play_notification_sound
      newly_unseen=$(jq --arg m "$member" '. + [$m]' <<<"$newly_unseen")
    fi
    i=$((i + 1))
  done

  # Persist (not just changed ones, so a task that goes in_progress again
  # later — a follow-up message — is correctly seen as "was in_progress" on
  # its next transition too). Merges into the CURRENT on-disk marker rather
  # than rebuilding from scratch, so this doesn't clobber what cmd_poll_all
  # just wrote (.transcripts / .unseen).
  local new_statuses
  new_statuses=$(jq '[.[] | {key: .id, value: .status}] | from_entries' <<<"$tasks")
  jq --argjson statuses "$new_statuses" --argjson extra "$newly_unseen" \
    '.taskStatuses = $statuses | .unseen = ((.unseen // []) + $extra | unique)' \
    <<<"$(read_marker)" > "$notify_marker_path"

  jq -n --argjson fired "$count" --argjson members "$(jq '.unseen // []' <<<"$(read_marker)")" \
    '{fired:$fired, unseenMembers:$members}'
}

cmd_notifications_mark_seen() {
  local now marker
  now=$(date +%s%3N)
  marker=$(read_marker)
  mkdir -p -- "$(dirname -- "$notify_marker_path")"
  jq --argjson ts "$now" '.lastSeenTs = $ts | .unseen = []' <<<"$marker" > "$notify_marker_path"
  jq -n --argjson ts "$now" '{ok:true, lastSeenTs:$ts}'
}

# --- tasks -------------------------------------------------------------------

load_tasks() {
  read_json_or "$tasks_path" '[]'
}

save_tasks() {
  local content=$1
  printf '%s' "$content" > "$tasks_path"
}

cmd_tasks_list() {
  load_tasks
}

cmd_tasks_add() {
  local member=$1 title=$2 message=${LEGION_MESSAGE:-}
  [[ -n $message ]] || die 2 'message required (pass via LEGION_MESSAGE env)'
  is_known_name "$member" || die 2 "unknown member: $member"
  [[ -n $title ]] || die 2 'title required'

  local id ts new_task tasks
  id=$(uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid)
  ts=$(date +%s%3N)
  new_task=$(jq -n --arg id "$id" --arg title "$title" --arg message "$message" \
    --arg member "$member" --argjson ts "$ts" \
    '{id:$id, title:$title, message:$message, member:$member, status:"backlog",
      createdAt:$ts, sentAt:null, reply:null, doneAt:null, delivered:false}')
  tasks=$(load_tasks | jq --argjson t "$new_task" '. + [$t]')
  save_tasks "$tasks"
  jq -n --argjson t "$new_task" '{ok:true, task:$t}'
}

# Drives a real pty attached to `claude attach ID`, types the message, presses
# Enter, then detaches — the same mechanism the webapp's own "Terminal" tab
# and its sendTextToSession() use (see server.js), just via python3's stdlib
# pty module here instead of node-pty. Detaching does not stop the session.
pty_send() {
  local agent_id=$1 text=$2
  python3 -I -c '
import os, pty, signal, sys, time

agent_id = sys.argv[1]
text = sys.argv[2]

pid, fd = pty.fork()
if pid == 0:
    try:
        os.execvp("claude", ["claude", "attach", agent_id])
    finally:
        os._exit(127)

try:
    time.sleep(0.5)
    os.write(fd, text.encode())
    time.sleep(0.2)
    os.write(fd, b"\r")
    time.sleep(0.7)
finally:
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    try:
        os.close(fd)
    except OSError:
        pass
' "$agent_id" "$text"
}

cmd_tasks_send() {
  local id=$1 followup=${2:-}
  local tasks task member text agent_id ts

  tasks=$(load_tasks)
  task=$(jq --arg id "$id" '.[] | select(.id == $id)' <<<"$tasks")
  [[ -n $task ]] || die 3 "unknown task: $id"
  [[ $(jq -r '.status' <<<"$task") != done ]] || die 2 'task is already done'

  member=$(jq -r '.member' <<<"$task")
  text=$followup
  [[ -n $text ]] || text=$(jq -r '.message' <<<"$task")
  text=${text//$'\n'/ }
  text=${text//$'\r'/ }
  text=${text//$'\t'/ }

  agent_id=$(run_agents_json | jq -r --arg m "$member" '.[] | select(.name == $m) | .id')
  [[ -n $agent_id && $agent_id != null ]] || die 1 "$member is offline"

  pty_send "$agent_id" "$text"

  ts=$(date +%s%3N)
  tasks=$(jq --arg id "$id" --arg text "$text" --argjson ts "$ts" '
    map(if .id == $id then
      (if $text != .message then .message = $text else . end)
      | .status = "in_progress" | .sentAt = $ts | .reply = null | .delivered = true
    else . end)
  ' <<<"$tasks")
  save_tasks "$tasks"
  jq --arg id "$id" '.[] | select(.id == $id) | {ok:true, task:.}' <<<"$tasks"
}

cmd_tasks_done() {
  local id=$1 tasks ts
  tasks=$(load_tasks)
  jq -e --arg id "$id" 'any(.[]; .id == $id)' >/dev/null <<<"$tasks" || die 3 "unknown task: $id"
  ts=$(date +%s%3N)
  tasks=$(jq --arg id "$id" --argjson ts "$ts" '
    map(if .id == $id then .status = "done" | .doneAt = $ts else . end)
  ' <<<"$tasks")
  save_tasks "$tasks"
  jq --arg id "$id" '.[] | select(.id == $id) | {ok:true, task:.}' <<<"$tasks"
}

# --- members -----------------------------------------------------------------

cmd_members_add() {
  local name=$1 cwd=$2
  [[ $name =~ $name_re ]] || die 2 'invalid name (lowercase/digits/dashes, starting with a letter)'
  ! is_known_name "$name" || die 2 'name already exists'
  [[ $cwd == /* ]] || die 2 'cwd must be an absolute path'

  mkdir -p -- "$cwd" || die 1 "could not create $cwd"

  local settings_dir=$cwd/.claude settings_path
  settings_path=$settings_dir/settings.json
  mkdir -p -- "$settings_dir"
  local settings='{}'
  if [[ -f $settings_path ]]; then
    settings=$(cat -- "$settings_path")
    jq -e . >/dev/null 2>&1 <<<"$settings" || { echo "warning: $settings_path is not valid JSON, leaving it alone" >&2; settings=''; }
  fi
  if [[ -n $settings ]]; then
    settings=$(jq '.worktree = ((.worktree // {}) + {bgIsolation: "none"})' <<<"$settings")
    printf '%s\n' "$settings" > "$settings_path"
  fi

  local members added_at
  added_at=$(date +%s%3N)
  members=$(dynamic_members_json | jq --arg name "$name" --arg cwd "$cwd" --argjson at "$added_at" \
    '. + [{name:$name, cwd:$cwd, addedAt:$at}]')
  printf '%s\n' "$members" > "$members_path"

  cmd_session_start "$name"
  jq -n --arg name "$name" --arg cwd "$cwd" '{ok:true, name:$name, cwd:$cwd}'
}

# --- session control -----------------------------------------------------------

cmd_session_start() {
  local name=$1
  is_known_name "$name" || die 2 "unknown session: $name"
  local already
  already=$(run_agents_json | jq -e --arg n "$name" 'any(.[]; .name == $n)' 2>/dev/null || echo false)
  if [[ $already == true ]]; then
    jq -n '{ok:true, note:"already running"}'
    return 0
  fi
  local cwd
  cwd=$(workspace_for "$name")
  [[ -n $cwd && -d $cwd ]] || die 1 "workspace not found for $name"
  ( cd "$cwd" && setsid claude --background --name "$name" --dangerously-skip-permissions >/dev/null 2>&1 & )
  jq -n '{ok:true}'
}

cmd_session_stop() {
  local name=$1
  is_known_name "$name" || die 2 "unknown session: $name"
  local agent_id
  agent_id=$(run_agents_json | jq -r --arg n "$name" '.[] | select(.name == $n) | .id')
  [[ -n $agent_id && $agent_id != null ]] || die 1 "$name is not running"
  claude stop "$agent_id" >/dev/null 2>&1 || die 1 'stop failed'
  jq -n '{ok:true}'
}

cmd_session_restart() {
  local name=$1
  cmd_session_stop "$name" || true
  sleep 1.2
  cmd_session_start "$name"
}

# Bootstraps the whole legion from cold, standalone — no dependency on the
# webapp or its start-sessions.sh being invoked by hand. If boss isn't
# running, starts ONLY boss: boss's own SessionStart hook (session-start-
# hook.sh in claude-legion) then brings up the fixed five + any dynamic
# members itself, exactly as it always has — no need to duplicate that
# cascade here. If boss is already up, that hook has already run at some
# point, so instead directly (re)start whichever fixed/dynamic member is
# currently not online — covers "boss is fine but one member crashed".
cmd_start_all() {
  local roster boss_online
  roster=$(run_agents_json)
  boss_online=$(jq -e 'any(.[]; .name == "boss")' <<<"$roster" >/dev/null 2>&1 && echo true || echo false)

  if [[ $boss_online != true ]]; then
    cmd_session_start boss >/dev/null
    jq -n '{ok:true, note:"boss started — its own startup hook brings up the rest"}'
    return 0
  fi

  local name names=("${fixed_names[@]}")
  while IFS= read -r name; do
    [[ -n $name ]] && names+=("$name")
  done < <(dynamic_members_json | jq -r '.[].name')

  for name in "${names[@]}"; do
    cmd_session_start "$name" >/dev/null 2>&1 || true
  done
  jq -n '{ok:true}'
}

# --- dispatch ------------------------------------------------------------------

command_name=${1:-}
case $command_name in
  roster)
    (($# == 2)) && [[ $2 == --json ]] || usage_error
    cmd_roster
    ;;
  cron-jobs)
    (($# == 2)) && [[ $2 == --json ]] || usage_error
    cmd_cron_jobs
    ;;
  usage)
    (($# == 2)) && [[ $2 == --json ]] || usage_error
    cmd_usage
    ;;
  notifications)
    subcommand=${2:-}
    case $subcommand in
      check)
        (($# == 2)) || usage_error
        cmd_notifications_check
        ;;
      mark-seen)
        (($# == 2)) || usage_error
        cmd_notifications_mark_seen
        ;;
      --limit)
        shift
        cmd_notifications "$@"
        ;;
      "")
        cmd_notifications
        ;;
      *) usage_error ;;
    esac
    ;;
  tasks)
    subcommand=${2:-}
    case $subcommand in
      list)
        (($# == 3)) && [[ $3 == --json ]] || usage_error
        cmd_tasks_list
        ;;
      add)
        (($# == 4)) || usage_error
        cmd_tasks_add "$3" "$4"
        ;;
      send)
        (($# == 3 || $# == 4)) || usage_error
        cmd_tasks_send "$3" "${4:-}"
        ;;
      done)
        (($# == 3)) || usage_error
        cmd_tasks_done "$3"
        ;;
      *) usage_error ;;
    esac
    ;;
  members)
    subcommand=${2:-}
    case $subcommand in
      add)
        (($# == 4)) || usage_error
        cmd_members_add "$3" "$4"
        ;;
      *) usage_error ;;
    esac
    ;;
  session)
    subcommand=${2:-}
    name=${3:-}
    [[ -n $name ]] || usage_error
    case $subcommand in
      start) cmd_session_start "$name" ;;
      stop) cmd_session_stop "$name" ;;
      restart) cmd_session_restart "$name" ;;
      *) usage_error ;;
    esac
    ;;
  start-all)
    (($# == 1)) || usage_error
    cmd_start_all
    ;;
  *)
    usage_error
    ;;
esac
